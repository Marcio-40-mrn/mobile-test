{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@wdio/globals/types",
      "@wdio/mocha-framework",
      "expect-webdriverio"
    ],
    "outDir": "./dist",
    "rootDir": "./"
  },
  "include": [
    "test/**/*.ts",
    "scripts/**/*.ts",
    "wdio.conf.ts"
  ]
}
